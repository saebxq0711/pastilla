# --- Base de datos (Supabase) -------------------------------------------------
# En Vercel: la cadena del pooler (puerto 6543). Para `npm run db:init`: la directa (5432).
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Acceso -------------------------------------------------------------------
# PIN de acceso (si no se define, es 0711).
APP_PIN=0711
# Cadena aleatoria larga (64+ caracteres).
SESSION_SECRET=
# Lo manda pg_cron (y el cron de Vercel) en "Authorization: Bearer ...".
CRON_SECRET=

# --- Correos ------------------------------------------------------------------
CORREO_EL=jsebasaranda2007@hotmail.com
CORREO_ELLA=lavalozqui0711@gmail.com
APP_URL=https://TU-APP.vercel.app
MAIL_NOMBRE=Pastillita

# Opción A: Gmail genérico con contraseña de aplicación (myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=

# Opción B: Resend con un dominio propio verificado
# RESEND_API_KEY=
# MAIL_FROM=Pastillita <recordatorio@tu-dominio.com>

# Solo local: imprime los correos en consola en vez de enviarlos.
# MAIL_MODO=log

# --- Horario (hora de Colombia) -----------------------------------------------
HORA_TOMA=21:00
MINUTOS_ALERTA=30
