# --- Base de datos (Supabase) -------------------------------------------------
# En Vercel: la cadena del pooler (puerto 6543). Para `npm run db:init`: la directa (5432).
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Acceso -------------------------------------------------------------------
# PIN de acceso (si no se define, es 0711).
APP_PIN=0711
# Cadena aleatoria larga (64+ caracteres).
SESSION_SECRET=
# Lo manda pg_cron (y el cron de Vercel) en "Authorization: Bearer ...".
CRON_SECRET=

# --- App ----------------------------------------------------------------------
APP_URL=https://TU-APP.vercel.app

# --- WhatsApp (npm run whatsapp:vincular una vez) ---------------------------
WHATSAPP_ELLA=57XXXXXXXXXX
WHATSAPP_EL=57XXXXXXXXXX
NOMBRE_ELLA=
NOMBRE_EL=
# Cómo se le habla a ella en la app y en sus mensajes
TRATO_ELLA=mi amor

# --- Horario (hora de Colombia) -----------------------------------------------
HORA_TOMA=21:00
MINUTOS_ALERTA=30
